{
  "name": "@baanish/synthetic-search-mcp",
  "version": "2.0.0",
  "description": "MCP server for Synthetic web search.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "synthetic-search-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "synthetic",
    "search",
    "stdio"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "hono": "^4.12.27",
    "@hono/node-server": "^1.19.14",
    "path-to-regexp": "^8.4.2",
    "fast-uri": "^4.1.0",
    "ip-address": "^10.2.0",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.6"
  }
}
